    title.InputBegan:Connect(function(i) if i.UserInputType==Enum.UserInputType.MouseButton1 or i.UserInputType==Enum.UserInputType.Touch then drag=true; ds=i.Position; sp=main.Position end end)
    title.InputEnded:Connect(function(i) if i.UserInputType==Enum.UserInputType.MouseButton1 or i.UserInputType==Enum.UserInputType.Touch then drag=false; Config.data.pos={sp.X.Offset,sp.Y.Offset}; saveCfg() end end)
    UIS.InputChanged:Connect(function(i) if drag and (i.UserInputType==Enum.UserInputType.MouseMovement or i.UserInputType==Enum.UserInputType.Touch) then local d=i.Position-ds; main.Position=UDim2.new(0.5,sp.X.Offset+d.X,0.5,sp.Y.Offset+d.Y) end end)
    if Config.data.pos then main.Position=UDim2.new(0.5,Config.data.pos[1],0.5,Config.data.pos[2]) end

    search:GetPropertyChangedSignal("Text"):Connect(function()
        local q=search.Text:lower()
        for _,cat in ipairs(self.categories) do
            for _,m in ipairs(cat.modules) do
                m.row.Visible=(q=="" or m.name:lower():find(q,1,true)~=nil)
            end
        end
    end)
    self:Show(true)
    return self
end

function Window:Show(instant)
    self.visible=true; ScreenGui.Enabled=true
    if instant then return end
    self.gui.Size=UDim2.fromOffset(600*0.8,450*0.8); self.gui.BackgroundTransparency=1
    tw(self.gui,0.2,{Size=UDim2.fromOffset(600,450),BackgroundTransparency=0.1})
end
function Window:Hide()
    self.visible=false
    tw(self.gui,0.15,{Size=UDim2.fromOffset(540,405),BackgroundTransparency=1})
    task.wait(0.15); ScreenGui.Enabled=false
    self.gui.Size=UDim2.fromOffset(600,450); self.gui.BackgroundTransparency=0.1
end

function Window:Category(name)
    local cat={name=name,modules={},window=self}
    local btn=new("TextButton",{Size=UDim2.new(1,0,0,35),BackgroundColor3=Colors.dark,BackgroundTransparency=1,Text="     "..name,Font=Enum.Font.GothamMedium,TextSize=14,TextColor3=Colors.sub,TextXAlignment=Enum.TextXAlignment.Left,AutoButtonColor=false,Parent=self.side}); corner(btn,6)
    new("Frame",{Size=UDim2.fromOffset(4,0),BackgroundColor3=Colors.accent,BorderSizePixel=0,Parent=btn})
    local page=new("Frame",{Size=UDim2.new(1,0,0,0),AutomaticSize=Enum.AutomaticSize.Y,BackgroundTransparency=1,Visible=false,Parent=self.scroll})
    new("UIListLayout",{Padding=UDim.new(0,6),SortOrder=Enum.SortOrder.LayoutOrder,Parent=page})
    cat.btn=btn; cat.page=page
    btn.MouseEnter:Connect(function() if self.activeCat~=cat then tw(btn,0.15,{BackgroundColor3=Colors.hover,BackgroundTransparency=0}) end end)
    btn.MouseLeave:Connect(function() if self.activeCat~=cat then tw(btn,0.15,{BackgroundTransparency=1}) end end)
    btn.MouseButton1Click:Connect(function() self:SelectCategory(cat) end)
    table.insert(self.categories,cat)
    if not self.activeCat then self:SelectCategory(cat) end
    return cat
end

function Window:SelectCategory(cat)
    for _,c in ipairs(self.categories) do
        local on=(c==cat)
        c.page.Visible=on and not c.isCombos
        tw(c.btn,0.15,{BackgroundColor3=on and Colors.panel or Colors.dark,BackgroundTransparency=on and 0 or 1,TextColor3=on and Colors.text or Colors.sub})
    end
    self.scroll.Visible=not cat.isCombos
    self.search.Visible=not cat.isCombos
    for _,pg in ipairs(self.extraPages) do pg.Visible=(pg.owner==cat) end
    self.activeCat=cat
end

function Window:Module(cat,name,default,callback)
    local mod={name=name,cat=cat,value=FlagsGet(name)}
    if mod.value==nil then mod.value=default or false end
    FlagsSet(name,mod.value)
    local row=new("Frame",{Size=UDim2.new(1,0,0,40),BackgroundColor3=Colors.panel,BackgroundTransparency=0.05,BorderSizePixel=0,Parent=cat.page}); corner(row,4); stroke(row,Colors.off,1,0.6)
    mod.row=row
    new("TextLabel",{BackgroundTransparency=1,Position=UDim2.fromOffset(15,0),Size=UDim2.new(1,-80,1,0),Font=Enum.Font.Gotham,TextSize=14,TextColor3=Colors.text,TextXAlignment=Enum.TextXAlignment.Left,Text=name,Parent=row})
    local track=new("Frame",{Size=UDim2.fromOffset(40,20),Position=UDim2.new(1,-52,0.5,-10),BackgroundColor3=mod.value and Colors.accent or Colors.off,Parent=row}); corner(track,10)
    local knob=new("Frame",{Size=UDim2.fromOffset(16,16),BackgroundColor3=Colors.text,Position=mod.value and UDim2.fromOffset(22,2) or UDim2.fromOffset(2,2),Parent=track}); corner(knob,8)
    local function set(v) mod.value=v; FlagsSet(name,v); tw(track,0.2,{BackgroundColor3=v and Colors.accent or Colors.off}); tw(knob,0.2,{Position=v and UDim2.fromOffset(22,2) or UDim2.fromOffset(2,2)}); saveCfg(); if callback then callback(v) end end
    mod.Set=set; mod.Get=function() return mod.value end
    track.InputBegan:Connect(function(i) if i.UserInputType==Enum.UserInputType.MouseButton1 or i.UserInputType==Enum.UserInputType.Touch then set(not mod.value) end end)
    table.insert(cat.modules,mod)
    return mod
end

