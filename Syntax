local function parseCombo(str)
    str = str:gsub("→","|"):gsub("%->","|"):gsub("/","|")
    local steps={}
    for token in string.gmatch(str,"([^|]+)") do
        token = token:match("^%s*(.-)%s*$")
        if token~="" then
            local step={label=token,delay=0.2,type="key"}
            local lower=token:lower()
            if token:find("M1") then
                step.type="click"; step.count=tonumber(token:match("x%s*(%d+)")) or (lower:find("spam") and 5 or 1)
            elseif lower:find("dash") then step.type="dash"
            elseif lower:find("look") or lower:find("вниз") or lower:find("назад") or lower:find("смотреть") then step.type="look"
            else
                local key=nil
                for k in token:gmatch("%f[%a]([ZXCVF])%f[%A]") do key=k end
                if not key then key=token:match("([ZXCVF])$") end
                if key then
                    step.key=key
                    step.tool=(token:match("^(.-)%s*[ZXCVF]$") or token):gsub("%s+$","")
                    if step.tool=="" then step.tool=nil end
                    step.hold = (lower:find("hold") ~= nil) or (lower:find("зажать") ~= nil)
                else
                    if token:match("^[ZXCVF]$") then step.key=token end
                end
            end
            steps[#steps+1]=step
        end
    end
    return steps
end
for _,c in ipairs(Raw) do c.steps=parseCombo(c.combo) end

local running, currentSlot, runThread = false,nil,nil
local function switchTo(tool)
    if not tool or tool=="" then return end
    local slot=ToolSlots[tool]
    if slot and slot~=currentSlot then
        pcall(function() keypress(tostring(slot)) end); task.wait(0.05)
        pcall(function() keyrelease(tostring(slot)) end)
        currentSlot=slot; task.wait(0.12)
    end
end
local function execStep(step, mul)
    if step.type=="key" and step.key then
        switchTo(step.tool)
        pcall(function() keypress(step.key:lower()) end)
        task.wait(step.hold and 0.4 or 0.06)
        pcall(function() keyrelease(step.key:lower()) end)
    elseif step.type=="click" then
        for _=1,(step.count or 1) do pcall(function() mouse1click() end); task.wait(0.08) end
    elseif step.type=="dash" then
        local k=Flags["dash_key"]; if k and k~="" then pcall(function() keypress(k); task.wait(0.05); keyrelease(k) end) end
    elseif step.type=="look" then
        local k=Flags["look_key"]; if k and k~="" then pcall(function() keypress(k); task.wait(0.05); keyrelease(k) end) end
    end
    task.wait((step.delay or 0.2)*(mul or 1))
end
local function runCombo(combo)
    if runThread then task.cancel(runThread) end
    running=true
    runThread=task.spawn(function()
        for _,step in ipairs(combo.steps) do
            if not running then break end
            execStep(step,(Flags["combo_speed"] or 10)/10)
        end
        running=false; runThread=nil
    end)
end
local function stopCombo() running=false; if runThread then task.cancel(runThread); runThread=nil end end

