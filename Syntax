function Window:SelectTab(tab)
    for _,t in ipairs(self.tabs) do
        local on=(t==tab); t.page.Visible=on
        tween(t.button,0.15,{BackgroundTransparency=on and 0.7 or 1, TextColor3=on and Theme.text or Theme.dim})
    end
    self.activeTab=tab
end

