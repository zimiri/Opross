local function buildCombosPage(win, cat)
    local content = win.content
    local page = new("Frame",{Size=UDim2.fromScale(1,1),BackgroundTransparency=1,Visible=false,Parent=content})
    page.owner = cat
    table.insert(win.extraPages, page)

    local searchFruit = new("TextBox",{Size=UDim2.new(1,-20,0,30),Position=UDim2.fromOffset(10,10),BackgroundColor3=Colors.panel,Text="",PlaceholderText="Поиск фрукта...",Font=Enum.Font.Gotham,TextSize=13,TextColor3=Colors.text,PlaceholderColor3=Colors.sub,ClearTextOnFocus=false,TextXAlignment=Enum.TextXAlignment.Left,Parent=page}); corner(searchFruit,6); stroke(searchFruit,Colors.off,1,0.5)
    new("UIPadding",{PaddingLeft=UDim.new(0,10),Parent=searchFruit})

    local fruitList = new("ScrollingFrame",{Size=UDim2.new(0,180,1,-92),Position=UDim2.fromOffset(10,48),BackgroundColor3=Colors.dark,BackgroundTransparency=0.05,BorderSizePixel=0,ScrollBarThickness=3,ScrollBarImageColor3=Colors.accent,CanvasSize=UDim2.new(),AutomaticCanvasSize=Enum.AutomaticSize.Y,Parent=page}); corner(fruitList,6)
    new("UIListLayout",{Padding=UDim.new(0,2),Parent=fruitList})
    new("UIPadding",{PaddingTop=UDim.new(0,4),PaddingLeft=UDim.new(0,4),PaddingRight=UDim.new(0,4),Parent=fruitList})

    local comboList = new("ScrollingFrame",{Size=UDim2.new(1,-210,1,-92),Position=UDim2.fromOffset(200,48),BackgroundTransparency=1,BorderSizePixel=0,ScrollBarThickness=3,ScrollBarImageColor3=Colors.accent,CanvasSize=UDim2.new(),AutomaticCanvasSize=Enum.AutomaticSize.Y,Parent=page})
    new("UIListLayout",{Padding=UDim.new(0,6),Parent=comboList})

    local bottom = new("Frame",{Size=UDim2.new(1,-20,0,34),Position=UDim2.new(0,10,1,-40),BackgroundTransparency=1,Parent=page})
    local autoBtn = new("TextButton",{Size=UDim2.fromOffset(200,30),Position=UDim2.fromOffset(0,2),BackgroundColor3=Colors.off,Text="Auto Combo: OFF",Font=Enum.Font.GothamBold,TextSize=13,TextColor3=Colors.text,AutoButtonColor=false,Parent=bottom}); corner(autoBtn,6)
    local delayLbl = new("TextLabel",{BackgroundTransparency=1,Position=UDim2.fromOffset(214,0),Size=UDim2.fromOffset(120,30),Font=Enum.Font.Gotham,TextSize=12,TextColor3=Colors.sub,TextXAlignment=Enum.TextXAlignment.Left,Text="Delay: 0.15",Parent=bottom})
    local delayBar = new("Frame",{Size=UDim2.fromOffset(150,6),Position=UDim2.fromOffset(214,22),BackgroundColor3=Colors.off,Parent=bottom}); corner(delayBar,3)
    local delayFill = new("Frame",{Size=UDim2.new(0.22,0,1,0),BackgroundColor3=Colors.accent,Parent=delayBar}); corner(delayFill,3); grad(delayFill,Colors.accent,Colors.accent2,0)

    local state = getgenv().SyntaxComboState or {fruit=nil,index=1,delay=0.15,auto=false,range=15}
    getgenv().SyntaxComboState = state
    state.delay = state.delay or 0.15

    local function updateAuto()
        autoBtn.Text = "Auto Combo: "..(state.auto and "ON" or "OFF")
        autoBtn.BackgroundColor3 = state.auto and Colors.accent or Colors.off
    end
    updateAuto()
    autoBtn.MouseButton1Click:Connect(function()
        state.auto=not state.auto; updateAuto(); saveCfg()
        Notify("Combos","Auto Combo "..(state.auto and "ON" or "OFF"),state.auto and "success" or "error")
    end)

    local function setDelay(d)
        state.delay=math.clamp(d,0.05,0.5)
        delayLbl.Text=string.format("Delay: %.2f",state.delay)
        delayFill.Size=UDim2.new((state.delay-0.05)/0.45,0,1,0)
        getgenv().ComboDelay=state.delay; saveCfg()
    end
    setDelay(state.delay)
    local dDrag=false
    delayBar.InputBegan:Connect(function(i) if i.UserInputType==Enum.UserInputType.MouseButton1 or i.UserInputType==Enum.UserInputType.Touch then dDrag=true end end)
    UIS.InputChanged:Connect(function(i) if dDrag and (i.UserInputType==Enum.UserInputType.MouseMovement or i.UserInputType==Enum.UserInputType.Touch) then local r=math.clamp((i.Position.X-delayBar.AbsolutePosition.X)/delayBar.AbsoluteSize.X,0,1); setDelay(0.05+0.45*r) end end)
    UIS.InputEnded:Connect(function(i) if i.UserInputType==Enum.UserInputType.MouseButton1 or i.UserInputType==Enum.UserInputType.Touch then dDrag=false end end)

    local function difficultyColor(d)
        if d=="Very Easy" or d=="Easy" then return Colors.success
        elseif d=="Medium" then return Colors.warn
        else return Colors.error end
    end

    local function buildCombos(fruit)
        for _,ch in ipairs(comboList:GetChildren()) do if ch:IsA("Frame") or ch:IsA("TextLabel") then ch:Destroy() end end
        local list = Combos[fruit]
        if not list then
            new("TextLabel",{Size=UDim2.new(1,0,0,30),BackgroundTransparency=1,Font=Enum.Font.Gotham,TextSize=14,TextColor3=Colors.sub,Text="Нет комбо для этого фрукта",Parent=comboList})
            return
        end
        for i,combo in ipairs(list) do
            local card=new("Frame",{Size=UDim2.new(1,-10,0,90),BackgroundColor3=Colors.panel,BackgroundTransparency=0.05,BorderSizePixel=0,Parent=comboList}); corner(card,6); stroke(card,Colors.accent,1,0.6)
            new("TextLabel",{BackgroundTransparency=1,Position=UDim2.fromOffset(12,8),Size=UDim2.new(1,-80,0,18),Font=Enum.Font.GothamBold,TextSize=14,TextColor3=Colors.text,TextXAlignment=Enum.TextXAlignment.Left,Text=string.format("Combo %d — %s",i,combo.name),Parent=card})
            new("TextLabel",{BackgroundTransparency=1,Position=UDim2.fromOffset(12,28),Size=UDim2.new(1,-80,0,16),Font=Enum.Font.Code,TextSize=12,TextColor3=Colors.accent,TextXAlignment=Enum.TextXAlignment.Left,Text=table.concat(combo.moves," → "),Parent=card})
            new("TextLabel",{BackgroundTransparency=1,Position=UDim2.fromOffset(12,48),Size=UDim2.new(0,200,0,14),Font=Enum.Font.Gotham,TextSize=11,TextColor3=Colors.sub,TextXAlignment=Enum.TextXAlignment.Left,Text="Target: "..(combo.target or "All"),Parent=card})
            new("TextLabel",{BackgroundTransparency=1,Position=UDim2.fromOffset(12,64),Size=UDim2.new(0,200,0,14),Font=Enum.Font.Gotham,TextSize=11,TextColor3=difficultyColor(combo.difficulty),TextXAlignment=Enum.TextXAlignment.Left,Text="Difficulty: "..(combo.difficulty or "Medium"),Parent=card})
            local run=new("TextButton",{Size=UDim2.fromOffset(36,36),Position=UDim2.new(1,-48,0.5,-18),BackgroundColor3=Colors.accent,Text="▶",Font=Enum.Font.GothamBold,TextSize=16,TextColor3=Colors.text,AutoButtonColor=false,Parent=card}); corner(run,6)
            run.MouseButton1Click:Connect(function()
                ExecuteCombo(fruit,i,state.delay)
                Notify("Combo",fruit.." · "..combo.name,"success")
            end)
            local select=new("TextButton",{Size=UDim2.new(1,-60,0,20),Position=UDim2.fromOffset(12,68),BackgroundColor3=Colors.panel2,Text="Выбрать для Auto",Font=Enum.Font.Gotham,TextSize=11,TextColor3=Colors.sub,AutoButtonColor=false,Parent=card}); corner(select,4)
            select.MouseButton1Click:Connect(function()
                state.fruit=fruit; state.index=i; saveCfg()
                Notify("Combos","Selected: "..fruit.." · "..combo.name,"success")
            end)
        end
    end

    local fruitButtons = {}
    local function selectFruit(fruit)
        state.fruit=fruit; saveCfg()
        for f,b in pairs(fruitButtons) do
            tw(b,0.15,{BackgroundColor3=(f==fruit) and Colors.hover or Colors.panel, TextColor3=(f==fruit) and Colors.text or Colors.sub})
        end
        buildCombos(fruit)
    end
    local function rebuildFruits(filter)
        for _,ch in ipairs(fruitList:GetChildren()) do if ch:IsA("TextButton") then ch:Destroy() end end
        fruitButtons={}
        filter=(filter or ""):lower()
        local names={}
        for name in pairs(Combos) do table.insert(names,name) end
        table.sort(names)
        for _,name in ipairs(names) do
            if filter=="" or name:lower():find(filter,1,true) then
                local b=new("TextButton",{Size=UDim2.new(1,0,0,32),BackgroundColor3=Colors.panel,BackgroundTransparency=0.1,Text="   "..name,Font=Enum.Font.Gotham,TextSize=13,TextColor3=Colors.sub,TextXAlignment=Enum.TextXAlignment.Left,AutoButtonColor=false,Parent=fruitList}); corner(b,4)
                b.MouseEnter:Connect(function() if state.fruit~=name then tw(b,0.12,{BackgroundColor3=Colors.hover}) end end)
                b.MouseLeave:Connect(function() if state.fruit~=name then tw(b,0.12,{BackgroundColor3=Colors.panel}) end end)
                b.MouseButton1Click:Connect(function() selectFruit(name) end)
                fruitButtons[name]=b
            end
        end
    end
    searchFruit:GetPropertyChangedSignal("Text"):Connect(function() rebuildFruits(searchFruit.Text) end)
    rebuildFruits("")
    local first
    for name in pairs(Combos) do first=first or name end
    if first then selectFruit(first) end

    return page
end

