--==================================================================
-- COMBO EXECUTOR
--==================================================================
local Camera = workspace.CurrentCamera
local function press(k) pcall(function() keypress(k) end) end
local function release(k) pcall(function() keyrelease(k) end) end
local function click() pcall(function() mouse1click() end) end

local function resolveKey(move)
    local last = move:match("([ZXCVF])$")
    if last then return last:lower() end
    local first = move:match("^([ZXCVF])")
    if first then return first:lower() end
    if #move == 1 then return move:lower() end
    return nil
end

local function doMove(move, delay)
    if move == "look_down" then
        Camera.CFrame = Camera.CFrame * CFrame.Angles(math.rad(45),0,0)
    elseif move == "look_back" then
        Camera.CFrame = Camera.CFrame * CFrame.Angles(0,math.rad(180),0)
    elseif move == "dash" or move == "Soru" or move == "FlashStep" then
        local dk = getgenv().SyntaxDashKey
        if dk and dk ~= "" then press(dk); task.wait(0.05); release(dk) end
    elseif move:find("_hold") then
        local key = resolveKey(move:gsub("_hold",""))
        if key then press(key); task.wait(0.45); release(key) end
    elseif move:find("M1x") then
        local count = tonumber(move:match("M1x(%d+)")) or 1
        for _=1,count do click(); task.wait(0.09) end
    elseif move == "M1" or move == "M1_spam" then
        local count = (move=="M1_spam") and 5 or 1
        for _=1,count do click(); task.wait(0.09) end
    else
        local key = resolveKey(move)
        if key then press(key); task.wait(delay or 0.15); release(key) end
    end
    task.wait(delay or 0.15)
end

local function ExecuteCombo(fruit, index, delay)
    if not Combos[fruit] or not Combos[fruit][index] then return end
    local combo = Combos[fruit][index]
    delay = delay or 0.15
    for _, move in ipairs(combo.moves) do
        doMove(move, delay)
    end
end
getgenv().SyntaxExecuteCombo = ExecuteCombo

--==================================================================
-- AUTO COMBO
--==================================================================
local comboRunning, comboCooldown = false, 0
local function nearestEnemy(range)
    local myRoot = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
    if not myRoot then return nil end
    local best, bestD = nil, range
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LP then
            local c = p.Character
            local hum = c and c:FindFirstChildOfClass("Humanoid")
            local root = c and c:FindFirstChild("HumanoidRootPart")
            if hum and hum.Health>0 and root then
                local d = (myRoot.Position - root.Position).Magnitude
                if d < bestD then best, bestD = p, d end
            end
        end
    end
    return best
end
RunService.Heartbeat:Connect(function(dt)
    local st = getgenv().SyntaxComboState
    if not st or not st.auto then comboRunning=false; return end
    comboCooldown = math.max(0, comboCooldown-dt)
    if comboRunning or comboCooldown>0 then return end
    if not nearestEnemy(st.range or 15) then return end
    comboRunning = true
    task.spawn(function()
        ExecuteCombo(st.fruit, st.index, st.delay)
        comboRunning = false
        comboCooldown = 0.5
    end)
end)

