local function updateESP()
    local on = Flags["esp"]
    local showNames = Flags["esp_names"]
    local showDist = Flags["esp_distance"]
    for _,p in ipairs(Players:GetPlayers()) do
        local c = p.Character
        if p ~= LP and c and alive(p) then
            if on then
                local h = c:FindFirstChild("SyntaxESP")
                if not h then h=Instance.new("Highlight"); h.Name="SyntaxESP"; h.DepthMode=Enum.HighlightDepthMode.AlwaysOnTop; h.Parent=c end
                h.FillColor=Theme.accent; h.OutlineColor=Color3.fromRGB(255,255,255)
                h.FillTransparency=0.65; h.OutlineTransparency=0
                local tag=c:FindFirstChild("SyntaxName")
                if not tag then
