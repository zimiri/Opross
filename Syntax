RunService.RenderStepped:Connect(function()
    if not Flags["Aimbot"] then return end
    local target = nearest(Flags["Aim Range"] or 40)
    if target and root(target) then
        cam.CFrame = CFrame.lookAt(cam.CFrame.Position, root(target).Position)
    end
end)

