local function renderDetail(combo)
    selected=combo
    for _,ch in ipairs(dSteps:GetChildren()) do if ch:IsA("TextLabel") then ch:Destroy() end end
    if not combo then dName.Text=L("none"); dMeta.Text=""; dIcon.Image=""; dIconFallback.Text="?"; return end
    dName.Text=combo.name
    dMeta.Text=string.format("%s · %s · %s",combo.cat,combo.diff,combo.target)
    local icon=FruitIcons[combo.cat]
    if icon and icon~="" then dIcon.Image=icon; dIconFallback.Visible=false
    else dIcon.Image=""; dIconFallback.Visible=true; dIconFallback.Text=string.sub(combo.cat,1,1) end
    for i,s in ipairs(combo.steps) do
        local lbl=Instance.new("TextLabel"); lbl.Size=UDim2.new(1,0,0,18); lbl.BackgroundTransparency=1
        lbl.TextXAlignment=Enum.TextXAlignment.Left; lbl.Font=Enum.Font.Code; lbl.TextSize=12
        lbl.TextColor3=Theme.dim; lbl.Text=string.format("%02d.  %s",i,s.label); lbl.Parent=dSteps
    end
end
local function rebuildList(cat)
    for _,ch in ipairs(list:GetChildren()) do if ch:IsA("TextButton") then ch:Destroy() end end
    for _,combo in ipairs(Raw) do
        if combo.cat==cat then
            local b=Instance.new("TextButton"); b.Size=UDim2.new(1,0,0,30); b.BackgroundColor3=Theme.card
            b.BackgroundTransparency=0.25; b.Text="  "..combo.name; b.TextXAlignment=Enum.TextXAlignment.Left
            b.Font=Enum.Font.GothamMedium; b.TextSize=12; b.TextColor3=Theme.text; b.Parent=list; corner(b,7)
            b.MouseButton1Click:Connect(function() renderDetail(combo) end)
            b.MouseEnter:Connect(function() tween(b,0.12,{BackgroundTransparency=0.05}) end)
            b.MouseLeave:Connect(function() tween(b,0.12,{BackgroundTransparency=0.25}) end)
        end
    end
end
local catButtons={}
local function selectCat(cat)
    for c,btn in pairs(catButtons) do tween(btn,0.15,{BackgroundTransparency=(c==cat) and 0.7 or 1, TextColor3=(c==cat) and Theme.text or Theme.dim}) end
    rebuildList(cat); renderDetail(nil)
end
local seen={}
for _,c in ipairs(Raw) do
    if not seen[c.cat] then
        seen[c.cat]=true
        local b=Instance.new("TextButton"); b.Size=UDim2.new(1,0,0,30); b.BackgroundColor3=Theme.card
        b.BackgroundTransparency=1; b.Text="  "..c.cat; b.TextXAlignment=Enum.TextXAlignment.Left
        b.Font=Enum.Font.GothamMedium; b.TextSize=12; b.TextColor3=Theme.dim; b.Parent=cats; corner(b,7)
        b.MouseButton1Click:Connect(function() selectCat(c.cat) end)
        catButtons[c.cat]=b
    end
end
selectCat(Raw[1].cat)
