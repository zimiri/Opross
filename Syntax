function Window:Slider(tab, text, min, max, default, callback)
    min, max = min or 0, max or 100
    local row = makeRow(tab.page, 44)
    local lbl = Instance.new("TextLabel")
    lbl.BackgroundTransparency = 1; lbl.Position = UDim2.fromOffset(12, 0); lbl.Size = UDim2.new(1, -70, 0, 22)
    lbl.TextXAlignment = Enum.TextXAlignment.Left; lbl.Font = Enum.Font.Gotham; lbl.TextSize = 13
    lbl.TextColor3 = Theme.text; lbl.Text = text; lbl.Parent = row

    local val = default or min; Flags[text] = val
    local valLbl = Instance.new("TextLabel")
    valLbl.BackgroundTransparency = 1; valLbl.Position = UDim2.new(1, -60, 0, 0); valLbl.Size = UDim2.fromOffset(48, 22)
    valLbl.TextXAlignment = Enum.TextXAlignment.Right; valLbl.Font = Enum.Font.GothamBold
    valLbl.TextSize = 12; valLbl.TextColor3 = Theme.accent; valLbl.Text = tostring(val); valLbl.Parent = row

    local bar = Instance.new("Frame")
    bar.Size = UDim2.new(1, -24, 0, 6); bar.Position = UDim2.fromOffset(12, 28)
    bar.BackgroundColor3 = Theme.off; bar.Parent = row; corner(bar, 3)
    local fill = Instance.new("Frame")
    fill.Size = UDim2.new((val - min) / (max - min), 0, 1, 0); fill.BackgroundColor3 = Theme.accent
    fill.Parent = bar; corner(fill, 3)

    local dragging = false
    local function apply(i)
        local rel = math.clamp((i.Position.X - bar.AbsolutePosition.X) / bar.AbsoluteSize.X, 0, 1)
        val = math.floor(min + (max - min) * rel + 0.5); Flags[text] = val
        valLbl.Text = tostring(val); fill.Size = UDim2.new(rel, 0, 1, 0)
        if callback then callback(val) end
    end
    bar.InputBegan:Connect(function(i) if i.UserInputType == Enum.UserInputType.MouseButton1 then dragging = true; apply(i) end end)
    UIS.InputChanged:Connect(function(i) if dragging and i.UserInputType == Enum.UserInputType.MouseMovement then apply(i) end end)
    UIS.InputEnded:Connect(function(i) if i.UserInputType == Enum.UserInputType.MouseButton1 then dragging = false end end)
    return { Set = function(v) val = v; Flags[text] = v; valLbl.Text = tostring(v); fill.Size = UDim2.new((v-min)/(max-min),0,1,0) end,
             Get = function() return val end }
end

