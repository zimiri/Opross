    local box = Instance.new("TextBox")
    box.Size = UDim2.new(0.5, -12, 0, 22); box.Position = UDim2.new(0.5, 0, 0.5, -11)
    box.BackgroundColor3 = Theme.panel; box.Text = default or ""; box.PlaceholderText = "..."
    box.Font = Enum.Font.Gotham; box.TextSize = 12; box.TextColor3 = Theme.text
    box.PlaceholderColor3 = Theme.dim; box.ClearTextOnFocus = false; box.Parent = row; corner(box, 5)
    box.FocusLost:Connect(function() Flags[text] = box.Text; if callback then callback(box.Text) end end)
    Flags[text] = default
    return box
end

