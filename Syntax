local lastHealth = nil
RunService.Heartbeat:Connect(function()
    if not Flags["AutoParry"] then lastHealth = nil; return end
    local hum = LP.Character and LP.Character:FindFirstChildOfClass("Humanoid"); if not hum then return end
    if lastHealth and hum.Health < lastHealth then CombatAPI.parry() end
    lastHealth = hum.Health
end)

