local function alive(p) return p and p.Character and p.Character:FindFirstChild("Humanoid") and p.Character.Humanoid.Health>0 end
local function root(p) return p and p.Character and p.Character:FindFirstChild("HumanoidRootPart") end

--==================================================================
-- SMART AIMBOT
--==================================================================
local function pickTarget(fov, maxRange)
    local best, bestAng = nil, math.huge
    local camPos = cam.CFrame.Position
    local look = cam.CFrame.LookVector
    for _,p in ipairs(Players:GetPlayers()) do
        if p ~= LP and alive(p) then
            local hrp = root(p)
            if hrp then
                local dir = hrp.Position - camPos
                local dist = dir.Magnitude
                if dist > 0.1 and dist <= maxRange then
                    local ang = math.deg(math.acos(math.clamp(look:Dot(dir.Unit),-1,1)))
                    if ang <= fov and ang < bestAng then bestAng=ang; best=p end
                end
            end
        end
    end
    return best
end

RunService.RenderStepped:Connect(function(dt)
    if not Flags["aimbot"] then return end
    local key = Flags["aim_key"] or Enum.KeyCode.E
    if not UIS:IsKeyDown(key) then return end
    local fov = Flags["aim_fov"] or 25
    local range = Flags["aim_range"] or 60
    local t = pickTarget(fov, range)
    if not t then return end
    local hrp = root(t); if not hrp then return end
    local aimPos = hrp.Position
    if Flags["aim_predict"] then aimPos = aimPos + hrp.AssemblyLinearVelocity * 0.12 end
    local alpha = math.clamp((Flags["aim_smooth"] or 12) / 100, 0.05, 0.9)
    cam.CFrame = cam.CFrame:Lerp(CFrame.lookAt(cam.CFrame.Position, aimPos), alpha)
end)

