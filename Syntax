-- ПАРСЕР
local function parseCombo(str)
    str = str:gsub("→", "|"):gsub("%->", "|"):gsub("/", "|")
    local steps = {}
    for token in string.gmatch(str, "([^|]+)") do
        token = token:match("^%s*(.-)%s*$")
        if token ~= "" then
            local step = { label = token, delay = 0.2, type = "key" }
            local lower = token:lower()
            if token:find("M1") then
                step.type = "click"
                step.count = tonumber(token:match("x%s*(%d+)")) or (lower:find("spam") and 5 or 1)
            elseif lower:find("dash") then
                step.type = "dash"
            elseif lower:find("look") then
                step.type = "look"
            else
                local key = nil
                for k in token:gmatch("%f[%a]([ZXCVF])%f[%A]") do key = k end
                if not key then key = token:match("([ZXCVF])$") end
                if key then
                    step.key = key
                    step.tool = (token:match("^(.-)%s*[ZXCVF]$") or token):gsub("%s+$", "")
                    if step.tool == "" then step.tool = nil end
                    step.hold = lower:find("hold") ~= nil
                else
                    step.type = "key"
                    if token:match("^[ZXCVF]$") then step.key = token end
                end
            end
            steps[#steps + 1] = step
        end
    end
    return steps
end
