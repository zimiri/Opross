local canIO = (type(writefile)=="function") and (type(readfile)=="function")
local Config = { path="syntax_config.json", data={} }
local function loadCfg()
    if not canIO then return end
    if not (isfile and isfile(Config.path)) then return end
    local ok,txt = pcall(readfile,Config.path)
    if ok and txt and txt~="" then local ok2,t=pcall(HttpService.JSONDecode,HttpService,txt); if ok2 and type(t)=="table" then Config.data=t end end
end
local function saveCfg()
    if not canIO then return end
    pcall(writefile, Config.path, HttpService:JSONEncode(Config.data))
end
loadCfg()
Config.data.flags = Config.data.flags or {}

local function FlagsGet(k) return Config.data.flags[k] end
