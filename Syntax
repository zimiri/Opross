-- УТИЛИТЫ PvP
--==================================================================
local function alive(p)
    return p and p.Character and p.Character:FindFirstChild("Humanoid") and p.Character.Humanoid.Health > 0
end
local function root(p)
    return p and p.Character and p.Character:FindFirstChild("HumanoidRootPart")
end
local function nearest(maxRange)
    local best, bestDist = nil, maxRange
    local myRoot = root(LP); if not myRoot then return nil end
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LP and alive(p) and root(p) then
            local d = (myRoot.Position - root(p).Position).Magnitude
            if d < bestDist then best, bestDist = p, d end
        end
    end
    return best, bestDist
end

